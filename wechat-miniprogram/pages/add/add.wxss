.amount-field {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 10rpx 4rpx 30rpx;
  border-bottom: 1rpx solid rgba(120, 82, 96, 0.12);
  margin-bottom: 30rpx;
}

.currency {
  font-size: 44rpx;
  font-weight: 700;
  color: #a63a57;
}

.amount-input {
  flex: 1;
  height: 96rpx;
  border: none;
  background: transparent;
  font-size: 64rpx;
  font-weight: 700;
  color: #302428;
  padding: 0;
}

.amount-input::placeholder {
  color: #d8c9cd;
}
