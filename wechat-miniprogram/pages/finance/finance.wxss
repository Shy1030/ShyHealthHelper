.summary-card {
  background: linear-gradient(135deg, #cf5775 0%, #a53f60 48%, #5f3a5c 100%);
  border-radius: 36rpx;
  padding: 34rpx 32rpx;
  color: #fff;
  box-shadow: 0 24rpx 54rpx rgba(166, 58, 87, 0.28);
  margin-bottom: 30rpx;
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.month-picker {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
}

.summary-grid {
  display: flex;
  gap: 12rpx;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.summary-label {
  font-size: 21rpx;
  opacity: 0.75;
}

.summary-value {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.summary-value.negative {
  color: #ffe2c4;
}

.summary-value.positive {
  color: #d7f5e9;
}

.breakdown {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.breakdown-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 21rpx;
  opacity: 0.92;
}

.breakdown-row .cat {
  width: 80rpx;
}

.breakdown-row .amount {
  width: 120rpx;
  text-align: right;
  font-size: 21rpx;
}

.bar {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
}

.list {
  padding: 6rpx 32rpx;
}

.record {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid rgba(120, 82, 96, 0.1);
}

.record:last-child {
  border-bottom: none;
}

.badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fbe9ee;
  color: #a63a57;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.badge-income {
  background: #e6f4ef;
  color: #4b9581;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 27rpx;
  font-weight: 600;
  word-break: break-all;
}

.record-sub {
  font-size: 22rpx;
  color: #8f7d83;
  margin-top: 4rpx;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.record-right .amount {
  font-size: 28rpx;
  font-weight: 700;
}

.record-right .amount.expense {
  color: #a63a57;
}

.record-right .amount.income {
  color: #4b9581;
}

.delete {
  font-size: 21rpx;
  color: #b4485f;
  padding: 4rpx 0;
}

.fab {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #c94f6d, #b23e60);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 40rpx rgba(201, 79, 109, 0.34);
  z-index: 20;
}
