# DeepSeek API（必填才能启用真实 AI；留空则使用 Mock 演示模式）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash 同时支持文本、图片理解与 JSON 输出
DEEPSEEK_MODEL=deepseek-flash
# 带图片的请求使用该模型（deepseek-v4-pro 不支持图片）
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60

# 设为 1 可强制使用 Mock 模式
AI_MOCK=

# 可选：自定义数据目录（默认 ./data）
APP_DATA_DIR=
# APP_DB_PATH=
# MAX_UPLOAD_MB=8
